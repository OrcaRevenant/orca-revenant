{
  "name": "orca-revenant",
  "version": "1.0.0",
  "description": "",
  "author": "localX",
  "main": "index.js",
  "scripts": {
    "build": "turbo build",
    "start:dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start:supabase": "supabase start",
    "restart:db": "supabase db restart",
    "run:functions": "supabase functions serve --no-verify-jwt --env-file .env.local",
    "gen:types": "supabase gen types typescript --local > database.types.ts",
    "apps:web-service": "turbo run --filter=\"web-service\"",
    "start:dev:web-service-doc": "turbo run --filter=\"web-service-doc\" start:dev",
    "start:dev:web-service": "turbo run --filter=\"web-service\" start:dev"
  },
  "license": "ISC",
  "dependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true
}
